PORT=5000
# No quotes. For Atlas: mongodb+srv://user:pass@cluster.mongodb.net/gupta_traders?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/gupta_traders
# Fix querySrv ECONNREFUSED on Windows / strict networks (Google + Cloudflare DNS)
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Admin portal (not in MongoDB — validated only via POST /api/auth/admin/login)
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=change-me-admin-password-min-8-chars
ADMIN_DISPLAY_NAME=System Admin
# Optional: bcrypt hash instead of plain ADMIN_PASSWORD
# ADMIN_PASSWORD_HASH=
