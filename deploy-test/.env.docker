# Copy to .env and customize before production:
#   cp .env.docker .env
#
# docker compose loads .env automatically when present (optional).
# Without .env, docker-compose.yml defaults are used.

API_PORT=5000
MONGO_ROOT_USERNAME=gupta
MONGO_ROOT_PASSWORD=changeme

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
CORS_ORIGIN=http://localhost:5173

ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=change-me-admin-password-min-8-chars
ADMIN_DISPLAY_NAME=System Admin

DO_SPACES_KEY=your-spaces-access-key
DO_SPACES_SECRET=your-spaces-secret-key
DO_SPACES_BUCKET=your-bucket-name
DO_SPACES_REGION=blr1
