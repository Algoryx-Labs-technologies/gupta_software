# Dependencies & build output (rebuilt inside the image)
node_modules
**/node_modules
dist
**/dist
**/*.tsbuildinfo

# Environment & secrets
.env
.env.*
!.env.example
apps/api/.env
apps/web/.env

# Git & IDE
.git
.gitignore
.github
.vscode
.idea

# Docs & misc
**/*.md
!apps/api/.env.example
coverage
*.log
.DS_Store
Thumbs.db

# Frontend (API image only)
apps/web

# Uploads (use object storage in production)
apps/api/uploads/*
!apps/api/uploads/.gitkeep
